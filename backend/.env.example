# Backend only. Never put these in frontend/VITE_* variables.
# Use Configure-Supabase.cmd for pending local configuration.
VETINSIGHT_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
VETINSIGHT_DATABASE_SCHEMA=vetinsight
VETINSIGHT_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_KEY
SUPABASE_BUCKET=vetinsight-records

# Optional experimental record extraction (language model). Leave unset to keep the feature switched off.
# ANTHROPIC_API_KEY is a secret: set it only as a server environment variable (for example in Railway), never in code.
# ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
# Optional model name; defaults to claude-haiku-5-5. No spaces or special characters in the variable name.
# VETINSIGHT_EXTRACTION_MODEL=claude-haiku-5-5
